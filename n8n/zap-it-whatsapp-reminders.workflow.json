      "id": "b48ee2e3-62db-445e-a743-6f85c75b21ef",
      "name": "Receber lembrete do Zap-it",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -860,
        120
      ],
      "webhookId": "zap-it-reminders-whatsapp"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\nconst item = payload.item ?? payload;\nconst phone = String(payload.phone ?? payload.to ?? item.phone ?? '').replace(/\\D/g, '');\nconst title = String(item.title ?? 'Lembrete Zap-it').trim();\nconst content = String(item.content ?? '').trim();\nconst reminderAt = item.reminderAt ?? payload.reminderAt;\n\nif (!phone) {\n  throw new Error('Informe o telefone em formato internacional. Exemplo: 5511999999999');\n}\n\nif (!reminderAt) {\n  throw new Error('Informe reminderAt em ISO 8601. Exemplo: 2026-05-25T15:00:00-03:00');\n}\n\nconst dueAt = new Date(reminderAt);\n\nif (Number.isNaN(dueAt.getTime())) {\n  throw new Error('reminderAt inválido. Use uma data ISO 8601.');\n}\n\nconst priority = item.priority ? `Prioridade: ${item.priority}` : '';\nconst category = item.category ? `Categoria: ${item.category}` : '';\nconst cardUrl = payload.cardUrl || item.cardUrl || '';\nconst details = [content, priority, category, cardUrl ? `Abrir no Zap-it: ${cardUrl}` : ''].filter(Boolean).join('\\n');\nconst message = [`Lembrete Zap-it`, '', title, details].filter(Boolean).join('\\n');\n\nreturn [\n  {\n    json: {\n      itemId: item.id ?? payload.itemId ?? null,\n      title,\n      content,\n      phone,\n      reminderAt: dueAt.toISOString(),\n      message,\n      source: 'zap-it'\n    }\n  }\n];"
      },
      "id": "b5697447-7924-43a3-8991-37e6829a8682",
      "name": "Validar e preparar lembrete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        120
      ]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $json.reminderAt }}"
      },
      "id": "c5c990c8-8e19-40d7-bbd7-27fd670f25d1",
      "name": "Aguardar horário do lembrete",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -140,
        120
