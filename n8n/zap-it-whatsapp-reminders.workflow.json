        "specifyBody": "json",
        "jsonBody": "={{ { number: $json.phone, text: $json.message, delay: 1200, linkPreview: false } }}",
        "options": {}
      },
      "id": "e57438e8-3809-4358-96c0-4ccfc8d52981",
      "name": "Enviar WhatsApp Evolution API",
