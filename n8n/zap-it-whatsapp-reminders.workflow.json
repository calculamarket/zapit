      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "BNmJVOuBbGXASe3H",
          "name": "Evolution API PROJETO - Zap-it"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      ok: true,\n      itemId: $json.itemId ?? null,\n      title: $json.title,\n      deliveredAt: new Date().toISOString(),\n      whatsappResponse: $json\n    }\n  }\n];"
      },
